/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-static.xml
  Content-Type: application/xml; charset=utf-8

/sitemap.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/data/*
  Cache-Control: public, max-age=1800
